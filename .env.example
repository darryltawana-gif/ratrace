# Copy to .env for local use. Never commit real credentials.
# On Render, set these in the service's Environment settings instead.

SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Production only
RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
REDIS_URL=redis://...
DATABASE_URL=postgresql://...

# Supabase storage (optional)
SUPABASE_PROJECT_REF=
SUPABASE_BUCKET=
SUPABASE_REGION=eu-west-1
SUPABASE_ACCESS_KEY=
SUPABASE_SECRET_KEY=

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# Password-reset email (production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=The Rat Race <no-reply@example.com>
